#!/bin/bash
#PBS -l select=1
#PBS -A radix-io
#PBS -l walltime=00:15:00
#PBS -N daos-s3-demo
#PBS -k doe
#PBS -j oe
#PBS -l filesystems=flare:daos_user_fs

cd $PBS_O_WORKDIR

export DAOS_POOL=radix-io
export DAOS_CONT=daos-s3-demo

launch-dfuse.sh ${DAOS_POOL}:${DAOS_CONT}
mpiexec -np 4 ./parallel-write-with-mpi /tmp/${DAOS_POOL}/${DAOS_CONT}/

